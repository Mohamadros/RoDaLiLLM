# Copy to .env only if your local tooling loads dotenv files. Never commit .env.
OPENAI_API_KEY=replace-with-your-api-key
RODALI_MODEL=gpt-4.1-mini

# Google Gemini Settings
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Marini Systems REST API (once provisioned by seminar mentors)
MARINI_API_URL=https://api.marini.systems/v1
MARINI_CLIENT_ID=
MARINI_CLIENT_SECRET=

# Threshold for duplicate matching
SIMILARITY_EVASION_THRESHOLD=0.75
